  "type": "module",
  "bugs": {
    "url": "https://github.com/youssefElMkhantar/temperature-sensor/issues"
  },
  "homepage": "https://github.com/youssefElMkhantar/temperature-sensor#readme",
  "dependencies": {
    "express": "^5.2.1",
    "supertest": "^7.2.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.1.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
